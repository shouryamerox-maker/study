# Copy to .env for local use, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ── Database (MySQL 8 / MariaDB 10.6+) ───────────────────────────────
# Aiven example: mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Public address of the website (used in password-reset and invitation links)
APP_URL="http://localhost:3000"

# ── Running C code (optional) ────────────────────────────────────────
# none   = Run buttons show "not available" (nothing is faked)
# judge0 = Judge0 CE (RapidAPI free plan, or self-hosted)
# piston = Piston (self-hosted)
EXECUTION_PROVIDER="none"
# JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_KEY="your-rapidapi-key"
# JUDGE0_HOST="judge0-ce.p.rapidapi.com"
# PISTON_URL="http://your-piston-host:2000"

# ── Email (optional: password resets and teacher invitations) ────────
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Studyline <no-reply@yourdomain.com>"
